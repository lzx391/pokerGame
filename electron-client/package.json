{
  "name": "mgdemoplus-client",
  "version": "1.0.0",
  "description": "MGDemoPlus 桌面客户端 - 在线德州扑克",
  "author": "MGDemoPlus Team",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "node scripts/prebuild.js",
    "build": "npm run prebuild && electron-builder --win dir --config.win.signAndEditExecutable=false",
    "build:cn": "set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ && node scripts/build.js"
  },
  "build": {
    "appId": "com.mgdemoplus.poker",
    "productName": "MGDemoPlus",
    "directories": {
      "output": "MGDemoPlus-win32-x64"
    },
    "files": [
      "main.js",
      "preload.js",
      "config.json",
      "dist-frontend/**/*"
    ],
    "win": {
      "target": "dir",
      "icon": null,
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
